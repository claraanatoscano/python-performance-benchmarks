FROM python:3.12

WORKDIR /app

RUN pip install flask pandas gunicorn requests

# Download ACS tract income data at build time using the provided script
COPY scripts/download_acs5_tract_income_us.py /tmp/download_acs5_tract_income_us.py
RUN mkdir -p /data && \
python /tmp/download_acs5_tract_income_us.py --out /data/acs5_2021_tract_income_us.csv

COPY app_server/* ./

ENV ACS_DATA=/data/acs5_2021_tract_income_us.csv

CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:8001", "server:app"]
